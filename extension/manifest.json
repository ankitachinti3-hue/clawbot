{
  "manifest_version": 3,
  "name": "CLAWBOT — Civic Intelligence",
  "version": "1.0.0",
  "description": "Civic assistant for Belagavi City Corporation. Calls CLAWBOT API on localhost or production.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"]
}
