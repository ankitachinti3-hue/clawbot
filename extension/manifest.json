{
  "manifest_version": 3,
  "name": "CLAWBOT — Civic Intelligence",
  "version": "1.0.0",
  "description": "Civic assistant for Belagavi City Corporation. Calls CLAWBOT API on localhost or production.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://api.cerebras.ai/*",
    "https://r.jina.ai/*",
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
